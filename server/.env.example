# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/cinebook_db

# Server Port
PORT=5000

# JWT Secret Key - IMPORTANT: Generate a strong random secret in production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-key-here

# Admin Registration Secret - Use a strong secret for admin registration
ADMIN_REGISTRATION_SECRET=your-admin-secret-here
